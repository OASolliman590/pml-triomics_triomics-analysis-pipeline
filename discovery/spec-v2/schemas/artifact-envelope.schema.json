{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "analysis_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "preparation_context_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "representation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "not_requested",
        "not_started",
        "running",
        "complete",
        "partial",
        "unavailable",
        "failed"
      ]
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "package",
        "version",
        "commit"
      ],
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "privacy_class": {
      "enum": [
        "synthetic",
        "public_reference",
        "private_study",
        "approved_aggregate"
      ]
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "study_id",
    "run_id",
    "analysis_id",
    "preparation_context_id",
    "representation_id",
    "status",
    "created_utc",
    "config_sha256",
    "inputs",
    "payload_sha256",
    "producer",
    "reason_codes",
    "privacy_class"
  ],
  "additionalProperties": false
}
