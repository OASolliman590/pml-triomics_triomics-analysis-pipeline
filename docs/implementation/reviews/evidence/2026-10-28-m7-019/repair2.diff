diff --git a/R/integration_endpoints.R b/R/integration_endpoints.R
index a8e540f..b99187f 100644
--- a/R/integration_endpoints.R
+++ b/R/integration_endpoints.R
@@ -481,9 +481,44 @@ triomics_c08_matrix_hash <- function(endpoint) {
   triomics_b_hash(list(endpoint_id = endpoint$endpoint_id, rows = rows))
 }
 
+triomics_c08_hash_visit_weights <- function(weights) {
+  if (is.numeric(weights) && !is.null(names(weights))) {
+    return(stats::setNames(as.list(unname(weights)), names(weights)))
+  }
+  weights
+}
+
 triomics_c08_endpoint_hash <- function(endpoint) {
   body <- endpoint
   body$endpoint_sha256 <- NULL
+  if (is.list(body$samples)) {
+    body$samples <- lapply(body$samples, function(sample) {
+      if ("visit_weights" %in% names(sample)) {
+        sample$visit_weights <- triomics_c08_hash_visit_weights(sample$visit_weights)
+      }
+      sample
+    })
+  }
+  if (is.data.frame(body$unit_map) && "visit_weights" %in% names(body$unit_map)) {
+    body$unit_map$visit_weights <- I(lapply(
+      body$unit_map$visit_weights,
+      triomics_c08_hash_visit_weights
+    ))
+  } else if (is.list(body$unit_map)) {
+    if ("visit_weights" %in% names(body$unit_map)) {
+      body$unit_map$visit_weights <- lapply(
+        body$unit_map$visit_weights,
+        triomics_c08_hash_visit_weights
+      )
+    } else {
+      body$unit_map <- lapply(body$unit_map, function(record) {
+        if (is.list(record) && "visit_weights" %in% names(record)) {
+          record$visit_weights <- triomics_c08_hash_visit_weights(record$visit_weights)
+        }
+        record
+      })
+    }
+  }
   triomics_c08_sha256(body)
 }
 
