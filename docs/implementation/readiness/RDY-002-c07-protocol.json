  "generator": {
    "samples": 64,
    "samples_per_subject": 1,
    "sample_id_format": "unit_%03d",
    "subject_id_format": "subject_%03d",
    "block_order": [
      "alpha",
      "beta"
    ],
    "features_per_block": 20,
    "feature_id_format": "<block>_f%02d",
    "matrix_orientation": "feature_by_unit",
    "set_seed_once_per_dataset": true,
    "draw_order_R": [
      "g <- rnorm(64)",
      "u <- rnorm(64)",
      "h <- rnorm(64)",
      "e_y <- rnorm(64)",
      "E_alpha <- matrix(rnorm(1280), nrow=20, ncol=64)",
      "E_beta <- matrix(rnorm(1280), nrow=20, ncol=64)"
    ],
    "R_matrix_filling": "column_major",
    "latent": "z <- 0.8*g + 0.6*u",
    "continuous_outcome": "y <- z + 0.5*e_y",
    "categorical_outcome": "order y ascending with unit ID as tie-break; first 32 control, last 32 case; levels control,case",
    "w": "w[j] <- if (j<=10) (-1)^(j-1) else 0 for j=1..20",
    "v": "v[j] <- if (j>=11) (-1)^(j-11) else 0 for j=1..20",
    "regime_order": [
      "null",
      "weak_signal",
      "strong_signal",
      "adversarial"
    ],
    "regimes": {
      "null": {
        "formula_each_block": "E_b",
        "noise_sd": 1,
        "components": 1
      },
      "weak_signal": {
        "formula_each_block": "0.15*outer(w,z) + E_b",
        "noise_sd": 1,
        "components": 1
      },
      "strong_signal": {
        "formula_each_block": "2*outer(w,z) + 0.5*E_b",
        "noise_sd": 0.5,
        "components": 1
      },
      "adversarial": {
        "formula_each_block": "2*outer(w,g) + 2*outer(v,h) + 0.5*E_b",
        "noise_sd": 0.5,
        "components": 2
      }
    },
    "shared_within_dataset_seed": [
      "hypothetical_units",
      "subjects",
      "feature_keys",
      "g",
      "u",
      "h",
      "e_y",
      "E_alpha",
      "E_beta",
      "z",
      "y",
      "class"
    ],
    "missing_cells": 0,
    "latent_variables_are_predictors": false,
    "outcome_driven_snr_adjustment": false
  },
  "matching_and_splits": {
    "grouping": "subject",
    "unit_to_subject_mapping": "one_to_one_matching_three_digit_suffix",
